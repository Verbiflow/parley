# Parley configuration. Copy to .env for local dev. Never commit real secrets.

# local | staging | production | dev-<name>
PARLEY_ENV=local
PARLEY_VERSION=dev

# Postgres (RDS). In every deployed environment append ?sslmode=require
DATABASE_URL=postgres://postgres@127.0.0.1:5432/parley
# Admin URL the test harness creates throwaway databases in
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/postgres

# Redis — connection→worker registry + pub/sub (Phase 5+)
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets: keep in a secrets manager, not here. Local uses built-in public test keys when unset. ---
# 32 bytes base64url — seals channel credentials at rest
# SIGN_IN_KEY=
# Private Ed25519 JWK (JSON) that signs connection tokens
# CONNECTION_SIGNING_KEY=
# WORKOS_CLIENT_ID=client_...
# WORKOS_API_KEY=sk_...

PUBLIC_URL=http://127.0.0.1:8787
