// Parley's edge app: the dashboard, sign-in, OAuth and MCP at app.itsparley.com.
// The WhatsApp sockets live on the EC2 sessions service (src/sessions-server.ts); see deploy/README.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "parley-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "app.itsparley.com", "custom_domain": true },
    // Marketing site (landing page only; every other path redirects to the app). See site() in src/worker.ts.
    { "pattern": "itsparley.com", "custom_domain": true },
    { "pattern": "www.itsparley.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "vars": {
    "PARLEY_ENV": "production",
    "PUBLIC_URL": "https://app.itsparley.com",
    "SITE_HOST": "itsparley.com"
  },
  // Postgres: Hyperdrive → Workers VPC service `parley-db` → Cloudflare Tunnel → private RDS.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "2b6f68bccc8945f7ba79eed9cfbe7d0b" }],
  // Live channel ops: Workers VPC service `parley-sessions` → Cloudflare Tunnel → EC2 127.0.0.1:8790.
  "vpc_services": [{ "binding": "SESSIONS", "service_id": "01a1a394-5089-7371-b9fb-d873d5c19b82" }],
  // Rate limits — keep in step with LIMITS in src/ratelimit.ts (requests per 60s).
  "ratelimits": [
    { "name": "RL_MCP", "namespace_id": "7001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_SIGNIN", "namespace_id": "7002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_DASHBOARD", "namespace_id": "7003", "simple": { "limit": 60, "period": 60 } }
  ]
  // Secrets (wrangler secret put): SIGN_IN_KEY, CONNECTION_SIGNING_KEY, WORKOS_CLIENT_ID, WORKOS_API_KEY, SESSIONS_SECRET
}
