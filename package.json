{
  "name": "parley",
  "private": true,
  "type": "module",
  "description": "Parley — an open messaging gateway for AI agents. Sign up, link a channel (WhatsApp first), use it over MCP.",
  "engines": { "node": ">=24" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
