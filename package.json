{
  "name": "parley",
  "private": true,
  "type": "module",
  "description": "Parley — an open messaging gateway for AI agents. Sign up, link a channel (WhatsApp first), use it over MCP.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-baileys.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "migrate": "node scripts/migrate.ts",
    "dev": "npm run dev -w @parley/api",
    "try:whatsapp": "node scripts/try-whatsapp.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@workos-inc/node": {
      "qs": "^6.17.1"
    },
    "iron-session": {
      "cookie": "^0.7.2"
    }
  }
}
