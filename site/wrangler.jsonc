// The marketing site at itsparley.com: the static Next.js build in out/ (`npm run build`), served by a small Worker
// of its own (worker.ts, logic in serve.ts). The app at app.itsparley.com is a separate Worker: see apps/api/wrangler.jsonc.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "parley-site",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "itsparley.com", "custom_domain": true },
    { "pattern": "www.itsparley.com", "custom_domain": true }
  ],
  // The Worker runs first so it can send www to the bare domain and unknown paths to the app.
  "assets": { "directory": "out", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true }
}
